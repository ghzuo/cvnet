{
  "files.associations": {
    "iosfwd": "cpp",
    "iterator": "cpp",
    "vector": "cpp",
    "ios": "cpp",
    "sstream": "cpp",
    "string": "cpp",
    "*.tcc": "cpp",
    "deque": "cpp",
    "list": "cpp",
    "system_error": "cpp",
    "unordered_map": "cpp",
    "hashtable": "cpp",
    "array": "cpp",
    "bitset": "cpp",
    "initializer_list": "cpp",
    "string_view": "cpp",
    "utility": "cpp",
    "typeinfo": "cpp",
    "*.rmd": "markdown",
    "ostream": "cpp",
    "limits": "cpp",
    "fstream": "cpp"
  },
  "cmake.configureArgs": [
    "-DSTATIC=ON"
  ],
  "cmake.sourceDirectory": "${workspaceFolder}/src",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/**",
    "${workspaceFolder}/src/kit",
  ],
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.cStandard": "c17",
  "C_Cpp.intelliSenseEngine": "default"
}